# Local development: fake. ECS: rds.
DATA_SOURCE=fake

# Required for refuge endpoints and when DATA_SOURCE=rds. Load real values
# through AWS Secrets Manager or the deployment environment.
RDS_HOST=
RDS_PORT=3306
RDS_DATABASE=
RDS_USER=
RDS_PASSWORD=
# Optional locally. The Docker image sets this to its bundled Amazon RDS CA.
RDS_SSL_CA=
ORS_API_KEY=
# Optional override. The default uses the current HeiGIT ORS API host.
# ORS_BASE_URL=https://api.heigit.org/openrouteservice/v2/directions/foot-walking/geojson

# US1.1 MVP thresholds. These are configurable engineering assumptions and
# should be calibrated with mentor/user feedback.
SENSOR_MATCH_RADIUS_M=120
MINIMUM_SENSOR_COVERAGE=0.20
HIGH_SENSORY_THRESHOLD=600
TRANSIT_RADIUS_M=250
ROUTE_SAMPLE_INTERVAL_M=80
SENSORY_RDS_CACHE_SECONDS=60
MAX_RECENT_COUNT_AGE_MINUTES=30

# Optional routing connection settings.
# RDS_SSL_CA=C:\path\to\rds-ca-bundle.pem
RDS_CONNECT_TIMEOUT_SECONDS=10

# Optional comma-separated browser origins. Do not add the file:// "null" origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://fit5120-2026s2-tp10.github.io,https://dpevp4238kw5k.cloudfront.net,https://calmpath-tp10.netlify.app
