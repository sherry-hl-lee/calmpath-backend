# Load real values through AWS Secrets Manager or your deployment environment.
# Never commit a populated .env file or RDS credentials.
MYSQL_HOST=your-rds-endpoint.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=fit5120_data
MYSQL_USER=fit5120_app
MYSQL_PASSWORD=replace-with-secret

# Optional: path to the RDS CA bundle when TLS is required by the deployment.
# MYSQL_SSL_CA=C:\path\to\rds-ca-bundle.pem
MYSQL_CONNECT_TIMEOUT_SECONDS=10

# Optional comma-separated browser origins. Do not add the file:// "null" origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://dpevp4238kw5k.cloudfront.net,https://calmpath-tp10.netlify.app
