# Local development: fake. ECS: rds.
DATA_SOURCE=fake

# Required for refuge endpoints and when DATA_SOURCE=rds. Load real values
# through AWS Secrets Manager or the deployment environment.
RDS_HOST=
RDS_PORT=3306
RDS_DATABASE=
RDS_USER=
RDS_PASSWORD=

# Optional routing connection settings.
# RDS_SSL_CA=C:\path\to\rds-ca-bundle.pem
RDS_CONNECT_TIMEOUT_SECONDS=10

# Optional comma-separated browser origins. Do not add the file:// "null" origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://fit5120-2026s2-tp10.github.io,https://dpevp4238kw5k.cloudfront.net,https://calmpath-tp10.netlify.app
