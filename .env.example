# Local development: fake. ECS: rds.
DATA_SOURCE=fake

# Required only when DATA_SOURCE=rds. Load real values through AWS Secrets
# Manager or the deployment environment; never commit credentials.
RDS_HOST=your-rds-endpoint.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=fit5120_data
RDS_USER=fit5120_app
RDS_PASSWORD=replace-with-secret

# Optional: path to the RDS CA bundle when TLS is required by the deployment.
# RDS_SSL_CA=C:\path\to\rds-ca-bundle.pem
RDS_CONNECT_TIMEOUT_SECONDS=10

# Optional comma-separated browser origins. Do not add the file:// "null" origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://dpevp4238kw5k.cloudfront.net,https://calmpath-tp10.netlify.app
