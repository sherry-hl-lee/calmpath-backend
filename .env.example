DATA_SOURCE=fake

RDS_HOST=
RDS_PORT=
RDS_DATABASE=
RDS_USER=
RDS_PASSWORD=
# Optional locally. The Docker image sets this to its bundled Amazon RDS CA.
RDS_SSL_CA=
ORS_API_KEY=

# US1.1 MVP thresholds. These are configurable engineering assumptions and
# should be calibrated with mentor/user feedback.
SENSOR_MATCH_RADIUS_M=120
MINIMUM_SENSOR_COVERAGE=0.20
HIGH_SENSORY_THRESHOLD=600
TRANSIT_RADIUS_M=250
ROUTE_SAMPLE_INTERVAL_M=80
SENSORY_RDS_CACHE_SECONDS=60
MAX_RECENT_COUNT_AGE_MINUTES=30
